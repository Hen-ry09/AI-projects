{
  "agent_name": "Akwaaba AI",
  "version": "0.1.0",
  "default_user_id": "default",
  "default_language": "en",
  "supported_languages": ["en", "tw", "ga", "ee", "ha"],
  "country_focus": "Ghana",
  "currency": "GHS",
  "timezone": "Africa/Accra",
